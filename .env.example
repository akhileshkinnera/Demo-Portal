# Copy this file to ".env.local" for local development.
# ".env.local" is git-ignored. Do NOT put passwords or secrets in any VITE_ variable:
# everything prefixed with VITE_ is bundled into the public JavaScript.

# Your deployed Google Apps Script Web App URL (ends with /exec). This URL is not a secret.
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Optional: name shown in the header and page titles
VITE_APP_NAME=Company Portal

# Development only: use built-in sample data instead of the real backend.
# Ignored (and removed from the bundle) in production builds.
# VITE_USE_MOCK=true
